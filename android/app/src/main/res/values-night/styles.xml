<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark variant: strips behind the system bars match the dark app background -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/appWindowBackground</item>
        <item name="android:statusBarColor">@color/appWindowBackground</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/appWindowBackground</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
